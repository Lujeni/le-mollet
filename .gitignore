/target
# rebuilt by `le-mollet terrain courses/<id>.json`
courses/*.terrain.bin
# fetched by `le-mollet buildings courses/<id>.city.json`
courses/*.buildings.bin
# fetched by `le-mollet district courses/<id>.city.json --bbox ...`
courses/*.district/
# fetched by `le-mollet ortho courses/<id>.json`
courses/*.ortho/
# built by `le-mollet island courses/<id>.map.json`
courses/ile-des-briques.city.json
# the server's database: riders, events, clubs, leaderboards, roles, sign-ins, Strava tokens (src/db.rs)
le-mollet.db*
# JSON files of older versions, imported into it
*.json.bak
courses/leaderboards.json
courses/clubs.json
courses/events.json
courses/riders.json
roles.json
strava-tokens.json
# the private ops repo, checked out here
le-mollet-ops/
le-mollet-website/
# ovhcloud CLI credentials, written where `ovhcloud login` is run
ovh.conf
