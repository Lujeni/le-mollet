/target
# rebuilt by `le-mollet terrain courses/<id>.json`
courses/*.terrain.bin
# fetched by `le-mollet buildings courses/<id>.city.json`
courses/*.buildings.bin
# fetched by `le-mollet district courses/<id>.city.json --bbox ...`
courses/*.district/
# fetched by `le-mollet ortho courses/<id>.json`
courses/*.ortho/
# built by `le-mollet island courses/<id>.map.json`
courses/ile-des-briques.city.json
# KOM and sprint times, written by the server as riders finish segments
courses/leaderboards.json
courses/clubs.json
courses/events.json
# roles by Strava athlete, and their Strava tokens: see docs/rbac.md
roles.json
strava-tokens.json
